---
//Layout.astro
//Encabezado y pie de página para todas las página comunes: todas las paginas
//lo que cambia de una pagina a otra ingresa por <slot/>

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import "../styles/variables.css";
import "../styles/global.css";


const base= import.meta.env.BASE_URL;
const { titulo, descripcion, activo, ancho = "normal"} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0 " />
    <meta name="theme-color" content="#6b0f0f" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.png`} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
  </head>

  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <Header activo={activo} />
    <main id="contenido" class:list={["principal",{"principal--ancho": ancho === "ancho"}]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
  .principal{
    padding-top: var(--esp-6);
    padding-bottom: var(--esp-6);
  }

  .principal--ancho{
    padding-top:0;
  }
</style>
