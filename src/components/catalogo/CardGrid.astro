---
//CardGrid.astro
//Rejilla de tarjetas de obra de arte: imagen, titulo, autor, periodo, tecnica.

import Card from "./Card.astro";
const { recetas } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<ul class="rejilla">
  {recetas.map((receta:any) => (
    <li>
      <Card receta={receta} />
    </li>
  ))}
</ul>
<style>
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--esp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
