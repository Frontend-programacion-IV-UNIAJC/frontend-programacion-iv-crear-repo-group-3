---
//CardGrid.astro
//Rejilla de tarjetas de obra de arte: imagen, titulo, autor, periodo, tecnica.

import Card from "./Card.astro";
const { obras=[] } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<ul class="rejilla">
  {obras.map((obra:any) => (
    <li>
      <Card obra={obra} />
    </li>
  ))}
</ul>
<style>
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--esp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
