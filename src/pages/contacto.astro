---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Catalogo — Arte Abierto" descripcion="Catalogo de obras de arte." activo="catalogo">
  <section class="contenedor">
     <p class="rotulo">Catalogo</p>
     <h1>Que puedes apreciar hoy</h1>
     <p class="entrada">Filtra por tecnica o periodo.</p>

     <div class="pendiente">Se construye en la clase 5.</div>
    </section>
  </Layout>
  <style>
  .entrada {
     max-width: var(--ancho-lectura);
     color: var(--color-texto-suave);
    }
  .pendiente {
    margin-top: var(--esp-5);
    padding: var(--esp-6) var(--esp-4);
    border: 2px dashed var(--color-borde-fuerte);
    border-radius: var(--radio-m);
    color: var(--color-texto-tenue);
    text-align: center;
  }
  </style>
